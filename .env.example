# Copy to .env and set this to wherever you unzipped the FDE assignment
# pack -- the folder that directly contains data/, bazaarpulse_site/ and
# partner_api/. Not committed; this data isn't ours to ship. Required --
# docker compose will refuse to start with a clear error if this is left
# unset or blank (see README: "How the assignment pack is used").
ASSIGNMENT_PACK_DIR=/absolute/path/to/FDE_Assignment_Pack_Kestrel_v1.1

# Optional. Leave blank to run without it -- the app works fully without
# a key (see DECISIONS.md / README): the 8 supported questions in
# Ask Anything work either way, free-form questions just report
# "AI unavailable" instead of failing.
#
# GROQ_API_KEY is the one that's actually wired up (backend/app/routers/ask.py):
# set it to enable free-form, AI-answered questions. Get a key at
# https://console.groq.com/keys -- never commit a real key, this file is
# for placeholders only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Kept for compatibility with earlier docs; not called by any code path today.
ANTHROPIC_API_KEY=
