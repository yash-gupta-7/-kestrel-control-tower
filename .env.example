# Copy to .env and set this to wherever you unzipped the FDE assignment
# pack -- the folder that directly contains data/, bazaarpulse_site/ and
# partner_api/. Not committed; this data isn't ours to ship.
ASSIGNMENT_PACK_DIR=/absolute/path/to/FDE_Assignment_Pack_Kestrel_v1.1

# Optional. Leave blank to run without it -- the app works fully without
# a key (see DECISIONS.md / README): the 8 supported questions in
# Ask Anything work either way, free-form questions just report
# "AI unavailable" instead of failing.
ANTHROPIC_API_KEY=
